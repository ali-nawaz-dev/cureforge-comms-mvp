# =============================================================================
# CureForge Comms MVP — Environment Template
# Copy this file to .env and fill in the values.
# .env is gitignored — NEVER commit real keys.
# =============================================================================

# ── Core runtime ─────────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql://cureforge:cureforge@localhost:5432/cureforge
REDIS_URL=redis://localhost:6379/0
BUS_BACKEND=memory         # memory (default) | redis
LEDGER_SQLITE_PATH=.local/ledger.sqlite3
KG_SQLITE_PATH=.local/kg.sqlite3

# ── LLM providers ────────────────────────────────────────────────────────────
# Routing confirmed by client:
#   Layer 1 parsing    → Groq + LLaMA 3.3 70B
#   Layer 2 rationale  → OpenAI GPT-4o
#   Layer 3A drafting  → OpenAI GPT-4o
#   Default / tests    → Mock (no key needed)
#
# NDA rule: NO INVESTOR_NDA-tier content reaches any LLM without explicit
# client sign-off. Milestone summaries and contact focus areas are fine.

LLM_PROVIDER=mock

# Per-layer overrides (falls back to LLM_PROVIDER if not set)
PARSER_LLM_PROVIDER=groq
RATIONALE_LLM_PROVIDER=openai
DRAFTING_LLM_PROVIDER=openai

# Groq — Layer 1 parsing (request from Oleg)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — Layer 2 + Layer 3A (request from Oleg, Day 3)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic — future phase only, not active default
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Resend outreach ───────────────────────────────────────────────────────────
# Domain: contact.longevityintime.org — VERIFIED ✅, sending enabled ✅
# Inbound: MX change in progress by Amine — NOT yet active ⚠️
#   Hold live reply-loop testing until Amine confirms inbound is verified.
#
# HOW TO FILL IN:
#   RESEND_API_KEY       → resend.com → API Keys → copy the re_... value
#   RESEND_SANDBOX_TO    → your personal test inbox (all sandbox sends go here)
#   RESEND_WEBHOOK_SECRET → resend.com → Webhooks → Signing Secret
#   OUTREACH_SEND_MODE   → keep "sandbox" until full client sign-off

OUTREACH_SEND_MODE=sandbox
RESEND_API_KEY=
RESEND_FROM_EMAIL=outreach@contact.longevityintime.org
RESEND_REPLY_TO=replies@contact.longevityintime.org
RESEND_SANDBOX_TO=
RESEND_WEBHOOK_SECRET=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token and notify chat ID coming from client — do not block Day 1 on this.
# HOW TO FILL IN:
#   TELEGRAM_BOT_TOKEN      → BotFather on Telegram → /newbot → copy token
#   TELEGRAM_NOTIFY_CHAT_ID → send a message to your bot, then call
#                             https://api.telegram.org/bot<TOKEN>/getUpdates
#                             and read the chat.id field

TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=
TELEGRAM_POLL_INTERVAL=300

# ── PubMed / NCBI ────────────────────────────────────────────────────────────
PUBMED_QUERY=longevity aging clinical trial
PUBMED_MAX_RESULTS=10
PUBMED_POLL_INTERVAL=1800
NCBI_API_KEY=          # optional — raises rate limit from 3 to 10 req/s

# ── ClinicalTrials.gov ────────────────────────────────────────────────────────
CT_QUERY=longevity aging
CT_MAX_RESULTS=10
CT_POLL_INTERVAL=3600

# ── ClickUp (optional — Day 6 if subscriber is built) ─────────────────────────
CLICKUP_API_TOKEN=
CLICKUP_SIGNAL_INTAKE_LIST_ID=
